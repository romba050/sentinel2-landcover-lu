# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
*.log

# Jupyter (keep committed notebooks - they are part of the write-up)
.ipynb_checkpoints/

# Data - do not commit raw satellite imagery or large files
data/raw/
data/processed/*.tif
data/processed/*.tiff
data/results/*.tif
data/results/*.tiff
*.h5
*.hdf5
*.nc

# Keep small processed outputs and final results
!data/results/figures/
!data/results/*.csv
!data/results/*.geojson

# QGIS
*.qgs~
*.qgz~

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local

# Models (any serialised format -- the RF joblib alone is ~160 MB)
models/*
!models/.gitkeep

# Private session/application notes -- never commit
.claude/
QGIS_README.md
